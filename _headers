/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate

/church/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-cache, must-revalidate

/promo-consulting.html
  Cache-Control: no-cache, must-revalidate
/promo/consulting
  Cache-Control: no-cache, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8
/humans.txt
  Content-Type: text/plain; charset=utf-8
  # 개발자용 크레딧 파일 — 검색결과에는 안 뜨게 합니다 (링크로만 접근)
  X-Robots-Tag: noindex

# 사이트맵은 크롤러가 파싱에 실패하면 페이지 발견 자체가 막힙니다.
# Content-Type 을 명시해 XML 로 확실히 전달하고, 캐시로 낡은 사본이 남지 않게 합니다.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# ===== 캐싱 =====
# JS·CSS 는 ?v= 로 버전 관리합니다. 다만 ?v 를 올리지 않고 배포하면
# immutable 캐시 때문에 브라우저가 최대 1년간 옛 파일을 계속 써서
# 도메인·기기별로 화면이 달라지는 사고가 납니다(2026-07 monnit.co.kr/monnit.ai 사례).
# → immutable 대신 stale-while-revalidate 를 씁니다.
#   · 캐시가 있으면 즉시 표시(체감 속도 동일)
#   · 동시에 백그라운드로 새 파일을 받아 다음 방문부터 자동 최신화
#   · ?v 를 올리면 그 즉시 새 파일을 받습니다
/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/views/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
# 폰트
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
# 아이콘·로고 등 정적 이미지(버전 없음) — 하루 캐시로 갱신은 빨리, 재방문은 캐시
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/assets/*
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

